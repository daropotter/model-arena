# Files and directories ignored by git.

# Results: raw evidence of runs. These contain absolute paths from the host
# they were produced on, model transcripts, and (potentially) local detail.
# Publish results selectively, e.g. only results/report.md, results/roster.md
# and results/models-report.md, and only from a machine you are comfortable
# exposing.
results/
results-*/
results-ab/
results-prescreen/
results-prescreen2/

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Prescreen output (regenerated by prescreen.py)
prescreen-passed.txt

# Scratch / local state
/tmp/
*.log
.DS_Store
