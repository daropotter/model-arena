#!/usr/bin/env python3
"""Transport only. Receipts and actual operations are owned by the supervisor."""
import json
import socket
import sys

try:
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as sock:
        sock.settimeout(180)
        sock.connect('/run/arena/ops.sock')
        sock.sendall(json.dumps(sys.argv[1:]).encode()+b'\n')
        with sock.makefile('rb') as stream:
            value=json.loads(stream.readline(2_000_000))
    print(json.dumps(value,ensure_ascii=False,indent=2))
    sys.exit(0 if value.get('outcome','passed')=='passed' else 1)
except (OSError,ValueError) as exc:
    print(json.dumps({'outcome':'failed','error':str(exc)}))
    sys.exit(1)
