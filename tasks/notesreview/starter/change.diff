--- a/notes/validation.py
+++ b/notes/validation.py
@@ -38,6 +38,22 @@
     return value
 
 
+def sort_key(value, allowed):
+    if value is None:
+        return "created"
+    if value not in allowed:
+        raise BadRequest("invalid sort")
+    return value
+
+
+def ttl_hours(value):
+    if value is None:
+        return 24
+    if type(value) is not int or not 1 <= value <= 168:
+        raise BadRequest("ttl_hours must be an integer from 1 to 168")
+    return value
+
+
 def limit(value, maximum):
     if value is None:
         return maximum
